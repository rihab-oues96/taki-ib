# URL of the CMS API (backoffice-back). Server-side only.
CMS_API_URL=https://taki-cms-api.onrender.com
# Must match SITE_REVALIDATE_SECRET and PREVIEW_SECRET in backoffice-back/.env
CMS_REVALIDATE_SECRET=change-me
CMS_PREVIEW_SECRET=change-me-too
# Must match FORMS_SECRET in backoffice-back/.env: lets this server post the forms (contact, pre-registration, jobs)
CMS_FORMS_SECRET=change-me-to-a-long-random-string
